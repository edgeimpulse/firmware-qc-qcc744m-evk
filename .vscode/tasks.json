{
    // Background OpenOCD server used by the debug launch configs.
    // Reuses debug.sh --server so the tool paths live in one place.
    "version": "2.0.0",
    "tasks": [
        {
            // Incremental build. Runs from the workspace root so build/ lands
            // where flash.sh/debug.sh expect it. Assumes the west venv is on
            // PATH and ZEPHYR_BASE is set in the environment; if not, activate
            // the venv before launching VS Code.
            "label": "west build (qcc744m)",
            "type": "shell",
            "command": "west build -b qcc744m_evk ${workspaceFolder}",
            "options": { "cwd": "${workspaceFolder}/.." },
            "group": "build",
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "west build --pristine (qcc744m)",
            "type": "shell",
            "command": "west build --pristine -b qcc744m_evk ${workspaceFolder}",
            "options": { "cwd": "${workspaceFolder}/.." },
            "group": { "kind": "build", "isDefault": true },
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "openocd (qcc744m)",
            "type": "shell",
            "command": "${workspaceFolder}/debug.sh",
            "args": ["--server"],
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": {
                // Only used to tell VS Code when the server is "ready".
                "pattern": {
                    "regexp": "^\\s*Error:\\s+(.*)$",
                    "message": 1
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Starting OpenOCD",
                    "endsPattern": "Listening on port \\d+ for gdb"
                }
            }
        },
        {
            "label": "openocd-stop",
            "type": "shell",
            "command": "pkill -f 'tools/openocd/openocd' || true",
            "presentation": { "reveal": "never", "panel": "shared" },
            "problemMatcher": []
        },
        {
            // preLaunchTask for the cppdbg config: build, then bring up the
            // gdb-server, in that order (the server is a background task, so
            // VS Code waits for its "Listening on port" line before F5 attaches).
            "label": "build + openocd (qcc744m)",
            "dependsOrder": "sequence",
            "dependsOn": ["west build (qcc744m)", "openocd (qcc744m)"],
            "problemMatcher": []
        }
    ]
}
